<Window x:Class="RepoTransit.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号与仓库设置 · 仓渡" Width="846" Height="634" MinWidth="774" MinHeight="615"
        WindowStartupLocation="CenterOwner" Icon="/Assets/RepoTransit.ico"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable,Microsoft YaHei UI" FontSize="13">
    <Grid Margin="26,20,26,22">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="账号与仓库" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="管理授权和上传目标，敏感凭据保存在本机" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1" CornerRadius="12" Padding="18,12,18,16">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="账号与授权">
                    <Grid Margin="2,12,2,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,22,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="已关联账号" FontWeight="SemiBold" Margin="4,0,0,12" />
                            <ListBox x:Name="AccountsList" Grid.Row="1" SelectionChanged="AccountsList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                <Button x:Name="NewGithubButton" Content="＋ 新增 GitHub 账号" Click="NewGithub_Click" Margin="0,0,0,8" />
                                <Button x:Name="NewGiteeButton" Content="＋ 新增 Gitee 账号" Click="NewGitee_Click" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock x:Name="AccountPlatform" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="账号配置" FontSize="18" FontWeight="SemiBold" />
                            </DockPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="本地显示名称" /><TextBox x:Name="AccountName" Margin="0,5,0,12" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="应用 Client ID" /><TextBox x:Name="ClientId" Margin="0,5,0,12" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="Gitee Client Secret（GitHub 无需填写）" TextTrimming="CharacterEllipsis" />
                                    <PasswordBox x:Name="ClientSecret" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Text="Gitee 回调端口" /><TextBox x:Name="CallbackPort" Text="47831" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="2" Text="Gitee 回调地址需与端口一致，例如 http://127.0.0.1:47831/callback"
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" />
                            <TextBlock x:Name="AccountStatus" Grid.Row="3" VerticalAlignment="Bottom" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,8,0,10" />
                            <WrapPanel Grid.Row="4" Margin="0,0,0,10">
                                <Button x:Name="AuthorizeButton" Content="浏览器授权" Click="Authorize_Click"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" />
                                <Button x:Name="CancelAuthButton" Content="取消授权" Click="CancelAuth_Click" IsEnabled="False" Margin="0,0,8,6" />
                                <Button Content="保存名称" Click="SaveAccountName_Click" Margin="0,0,8,6" />
                                <Button Content="断开本机授权" Click="Disconnect_Click" Margin="0,0,0,6" />
                            </WrapPanel>
                            <Border Grid.Row="5" Background="#F7F7F7" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="GitHub 需启用 Device Flow；Gitee 需注册应用并设置本机回调地址。"
                                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="GitHub 应用设置" Click="GithubApps_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                                        <Button Content="Gitee 应用设置" Click="GiteeApps_Click" Style="{StaticResource QuietButton}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="目标仓库">
                    <Grid Margin="2,12,2,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,22,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="已保存仓库" FontWeight="SemiBold" Margin="4,0,0,12" />
                            <ListBox x:Name="RepositoriesList" Grid.Row="1" SelectionChanged="RepositoriesList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="2" Content="＋ 新建仓库配置" Click="NewRepo_Click" Margin="0,12,0,0" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="仓库配置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="使用账号" /><ComboBox x:Name="RepoAccount" Margin="0,5,0,12" />
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="仓库拥有者 / 组织" /><TextBox x:Name="RepoOwner" Margin="0,5,0,12" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="仓库名称" /><TextBox x:Name="RepoName" Margin="0,5,0,12" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="分支" /><TextBox x:Name="RepoBranch" Text="main" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="本地显示名称（可留空）" /><TextBox x:Name="RepoDisplayName" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="RepoStatus" Grid.Row="4" VerticalAlignment="Bottom" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,8,0,10" />
                            <WrapPanel Grid.Row="5" Margin="0,0,0,10">
                                <Button Content="验证并保存" Click="SaveRepo_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                <Button Content="设为默认" Click="SetDefault_Click" Margin="0,0,8,0" />
                                <Button Content="删除配置" Click="RemoveRepo_Click" />
                            </WrapPanel>
                            <Border Grid.Row="6" Background="#F7F7F7" CornerRadius="8" Padding="12">
                                <TextBlock Text="仅支持已有私有仓库。保存前检查仓库与分支；写入权限由上传请求再次确认。"
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
