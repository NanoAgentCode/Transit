<Window x:Class="RepoTransit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="仓渡 RepoTransit" Width="1000" Height="690" MinWidth="900" MinHeight="550"
        Background="#F5F7FA" FontFamily="Microsoft YaHei UI" FontSize="13"
        AllowDrop="True" DragEnter="Window_DragEnter" Drop="Window_Drop">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/></Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#172033"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,22">
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="账号与仓库设置" Click="Settings_Click" Margin="8,0,0,0"/>
            <StackPanel><TextBlock Text="仓渡" FontSize="28" FontWeight="Bold"/><TextBlock Text="将文件送入你的私有仓库" Foreground="#64748B"/></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#DEE5ED" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <TextBlock Text="上传到" VerticalAlignment="Center" Margin="0,0,14,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="TargetBox" MinWidth="390" Height="32" SelectionChanged="TargetBox_SelectionChanged" DisplayMemberPath="DisplayLabel"/>
                <TextBlock x:Name="TargetHint" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#64748B"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Background="#EDF4FF" BorderBrush="#9BB7E8" BorderThickness="1" CornerRadius="9" Padding="20" Margin="0,0,0,14">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="将任意文件拖到这里" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="也可以点击下方按钮选择文件。上传前会再次确认目标仓库。" Foreground="#52637E" Margin="0,5,0,12" HorizontalAlignment="Center"/>
                <Button Content="选择文件" Click="ChooseFiles_Click" HorizontalAlignment="Center" Margin="0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#DEE5ED" BorderThickness="1" CornerRadius="9" Padding="12">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="4,2,4,12"><TextBlock Text="文件队列" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="QueueSummary" Margin="12,0,0,0" Foreground="#64748B"/></DockPanel>
                <DataGrid x:Name="FilesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0">
                    <DataGrid.Columns><DataGridTextColumn Header="本地文件" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="2*"/><DataGridTextColumn Header="仓库内路径" Binding="{Binding RemotePath}" Width="3*"/></DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#64748B"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="清空已完成" Click="Clear_Click"/><Button Content="复制文件链接" Click="CopyUrl_Click"/><Button Content="复制仓库路径" Click="CopyPath_Click"/><Button Content="重试选中项" Click="Retry_Click"/>
                <Button x:Name="CancelButton" Content="取消后续上传" Click="Cancel_Click" IsEnabled="False"/><Button x:Name="UploadButton" Content="开始上传" Click="Upload_Click" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Margin="0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
