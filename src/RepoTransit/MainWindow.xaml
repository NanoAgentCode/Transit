<Window x:Class="RepoTransit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="仓渡 · RepoTransit" Width="1080" Height="740" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="/Assets/RepoTransit.ico"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable,Microsoft YaHei UI" FontSize="13"
        AllowDrop="True" DragEnter="Window_DragEnter" Drop="Window_Drop">
    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,26">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="52" Height="52" Background="#E7F1FB" CornerRadius="12" Margin="0,0,16,0">
                    <Image Source="/Assets/RepoTransit.ico" Width="38" Height="38" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="仓渡" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="文件，安全抵达你的私有仓库" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="SettingsButton" Grid.Column="1" Content="账号与仓库设置" Click="Settings_Click"
                    VerticalAlignment="Center" Padding="16,9" />
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1" CornerRadius="12" Padding="20,17" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="目标仓库" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="选择本次上传位置" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <ComboBox x:Name="TargetBox" Grid.Column="1" MinWidth="220" HorizontalAlignment="Left"
                          VerticalAlignment="Center" SelectionChanged="TargetBox_SelectionChanged"
                          ToolTip="{Binding SelectedItem.DetailLabel, RelativeSource={RelativeSource Self}}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                            <Setter Property="ToolTip" Value="{Binding DetailLabel}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="TargetHint" Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0"
                           Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#F8FBFF" BorderBrush="#91BCE4" BorderThickness="1"
                CornerRadius="12" Padding="22,18" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="↓" FontSize="28" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="将文件拖放到这里" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0" />
                <TextBlock Text="支持任意文件类型 · 上传前会确认目标仓库" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,5,0,12" />
                <Button Content="选择文件" Click="ChooseFiles_Click" HorizontalAlignment="Center" Padding="19,8" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1" CornerRadius="12" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="文件队列" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="QueueSummary" Margin="12,3,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="重试" Click="Retry_Click" Style="{StaticResource QuietButton}" Margin="0,0,4,0" />
                        <Button Content="复制链接" Click="CopyUrl_Click" Style="{StaticResource QuietButton}" Margin="0,0,4,0" />
                        <Button Content="复制路径" Click="CopyPath_Click" Style="{StaticResource QuietButton}" Margin="0,0,4,0" />
                        <Button Content="清空已完成" Click="Clear_Click" Style="{StaticResource QuietButton}" />
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="FilesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single" GridLinesVisibility="None"
                          HeadersVisibility="Column" BorderThickness="0" RowHeight="44" ColumnHeaderHeight="38"
                          Background="White" RowBackground="White" AlternatingRowBackground="#FAFAFA"
                          HorizontalGridLinesBrush="{StaticResource StrokeBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="本地文件" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="2*" />
                        <DataGridTextColumn Header="仓库内路径" Binding="{Binding RemotePath}" Width="3*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="取消后续上传" Click="Cancel_Click" IsEnabled="False" Margin="0,0,10,0" />
                <Button x:Name="UploadButton" Content="开始上传" Click="Upload_Click" Style="{StaticResource PrimaryButton}" Padding="24,9" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
